---
import type { Producto } from '../data/compra';

interface Props {
  p: Producto;
  n?: number;
  opcional?: boolean;
}
const { p, n, opcional = false } = Astro.props;
const eur = (v: number) => {
  const [ent, frac] = v.toFixed(v % 1 ? 2 : 0).split('.');
  return `${ent.replace(/\B(?=(\d{3})+(?!\d))/g, '.')}${frac ? `,${frac}` : ''} €`;
};
const precio = p.precioTexto ?? eur(p.precio);
const num = n ? String(n).padStart(2, '0') : null;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const src = p.imagen && !p.imagen.startsWith('http') ? `${base}${p.imagen}` : p.imagen;
---

<article class:list={['card', { 'card--opt': opcional }]} id={`p-${p.id}`} data-id={p.id} data-precio={p.precio}>
  <div class:list={['card__media', { 'card__media--foto': p.foto }]}>
    {
      p.imagen ? (
        <img src={src} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
      ) : (
        <span class="card__ph" aria-hidden="true">
          {p.cat}
        </span>
      )
    }
    {num && <span class="card__num">{num}</span>}
  </div>
  <div class="card__body">
    <p class="card__cat">{p.cat}</p>
    <h3 class="card__name">{p.nombre}</h3>
    <p class="card__price">
      {precio}
      {p.precioTexto && !p.aprox && <span class="card__price-sub"> = {eur(p.precio)}</span>}
    </p>
    <div class="card__why">
      <span class="card__why-label">Por qué lo compro</span>
      <p>{p.porque}</p>
    </div>
    <ul class="card__chips">
      {p.datos.map((d) => <li>{d}</li>)}
    </ul>
    {p.aviso && <p class="card__note">{p.aviso}</p>}
    <div class="card__actions">
      <a class="btn btn--solid" href={p.url} target="_blank" rel="noopener noreferrer">
        {p.aprox ? `Buscar en ${p.tienda}` : `Comprar en ${p.tienda}`} <span aria-hidden="true">↗</span>
      </a>
      {
        p.otra && (
          <a class="card__alt" href={p.otra.url} target="_blank" rel="noopener noreferrer">
            o en {p.otra.tienda} ↗
          </a>
        )
      }
    </div>
    {
      !opcional && (
        <label class="card__done">
          <input type="checkbox" class="js-bought" value={p.id} />
          <span>Ya lo he comprado</span>
        </label>
      )
    }
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--coal-2);
    border: 1px solid var(--line-dark);
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }
  .card:hover {
    border-color: var(--gold);
  }
  .card.is-bought {
    border-color: var(--gold-deep);
  }
  .card.is-bought .card__media img {
    filter: grayscale(0.6);
    opacity: 0.7;
  }
  .card__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    background: #fff;
    padding: clamp(16px, 3vw, 28px);
    overflow: hidden;
  }
  .card__media.card__media--foto {
    padding: 0;
    background: var(--black);
  }
  .card__media.card__media--foto img {
    object-fit: cover;
  }
  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s ease;
  }
  .card:hover .card__media img {
    transform: scale(1.03);
  }
  :global(.card__ph) {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: var(--black);
    border: 1px solid var(--line-dark);
    color: var(--gold);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    text-align: center;
    padding: 12px;
  }
  .card__num {
    position: absolute;
    left: 0;
    top: 0;
    padding: 8px 14px;
    background: var(--black);
    color: var(--gold);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 20px;
    letter-spacing: 0.12em;
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(20px, 3vw, 28px);
  }
  .card__cat {
    margin: 0;
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .card__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(17px, 2vw, 20px);
    letter-spacing: 0.04em;
    line-height: 1.35;
    color: var(--cream);
  }
  .card__price {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 30px;
    color: var(--gold-light);
    line-height: 1.1;
  }
  .card__price-sub {
    font-size: 15px;
    color: var(--muted);
  }
  .card__why {
    padding: 4px 0 4px 16px;
    border-left: 2px solid var(--gold);
  }
  .card__why-label {
    display: block;
    margin-bottom: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card__why p {
    margin: 0;
    color: var(--cream);
  }
  .card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card__chips li {
    padding: 3px 10px;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    font-size: 12px;
    color: var(--muted);
  }
  .card__note {
    margin: 0;
    font-size: 14px;
    color: var(--gold-light);
  }
  .card__note::before {
    content: '✦ ';
    color: var(--gold);
  }
  .card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin-top: auto;
    padding-top: 6px;
  }
  .card__alt {
    font-size: 14px;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .card__alt:hover {
    color: var(--gold-light);
  }
  .card__done {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--muted);
    cursor: pointer;
    user-select: none;
  }
  .card__done input {
    width: 18px;
    height: 18px;
    accent-color: var(--gold);
  }
  .card--opt .card__price {
    font-size: 24px;
  }
</style>
