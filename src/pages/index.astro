    <script>
      const eur = (n: number) => `${String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.')} €`;
      const read = (k: string): string[] => {
        try {
          return JSON.parse(localStorage.getItem(k) ?? '[]');
        } catch {
          return [];
        }
      };
      const write = (k: string, v: string[]) => {
        try {
          localStorage.setItem(k, JSON.stringify(v));
        } catch {
          /* sin almacenamiento: no pasa nada */
        }
      };

      // Fotos de tienda que no cargan: se cambia por el nombre de la categoría
      document.querySelectorAll<HTMLImageElement>('.card__media img, .podium__media img, .opt__media img').forEach((img) => {
        const swap = () => {
          const ph = document.createElement('span');
          const card = img.closest('.card');
          ph.className = card ? 'card__ph' : 'ph';
          ph.textContent = (card ? card.querySelector('.card__cat') : img.closest('.opt, .podium__item')?.querySelector('.opt__type, .podium__type'))?.textContent ?? '';
          img.replaceWith(ph);
        };
        if (img.complete && img.naturalWidth === 0) swap();
        else img.addEventListener('error', swap);
      });

      // Lo comprado y lo elegido: marca tarjetas y ticket, y recalcula totales
      const KB = 'escritorio-ruben:comprado';
      const KT = 'escritorio-ruben:pendientes';
      const KE = 'escritorio-ruben:eleccion';
      type Pick = { id: string; name: string; price: number };
      const readPicks = (): Record<string, Pick> => {
        try {
          return JSON.parse(localStorage.getItem(KE) ?? '{}');
        } catch {
          return {};
        }
      };
      const picks = readPicks();
      const savePicks = () => {
        try {
          localStorage.setItem(KE, JSON.stringify(picks));
        } catch {
          /* sin almacenamiento */
        }
      };
      const labels: Record<string, string> = { silla: 'silla', camara: 'cámara', micro: 'micro' };
      const base = [...document.querySelectorAll<HTMLElement>('.card[data-precio]')]
        .filter((c) => c.querySelector('.js-bought'))
        .reduce((s, c) => s + Number(c.dataset.precio), 0);
      const bought = new Set(read(KB));
      const setText = (id: string, t: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = t;
      };
      const paint = () => {
        let paid = 0;
        document.querySelectorAll<HTMLInputElement>('.js-bought').forEach((i) => {
          const on = bought.has(i.value);
          i.checked = on;
          const card = i.closest<HTMLElement>('.card');
          card?.classList.toggle('is-bought', on);
          document.querySelector(`.ticket__row[data-id="${i.value}"]`)?.classList.toggle('is-done', on);
          if (on && card) paid += Number(card.dataset.precio);
        });
        let extra = 0;
        const missing: string[] = [];
        for (const g of Object.keys(labels)) {
          const p = picks[g];
          document.querySelectorAll<HTMLButtonElement>(`.js-pick[data-grupo="${g}"]`).forEach((b) => {
            const on = !!p && b.dataset.id === p.id;
            b.setAttribute('aria-pressed', String(on));
            b.closest('.opt')?.classList.toggle('is-picked', on);
          });
          const row = document.querySelector(`.ticket__row--pick[data-grupo="${g}"]`);
          if (row) {
            row.querySelector('.js-pick-name')!.textContent = p ? p.name : 'por elegir';
            row.querySelector('.js-pick-price')!.textContent = p ? eur(p.price) : '—';
            row.classList.toggle('is-picked', !!p);
          }
          if (p) extra += p.price;
          else missing.push(labels[g]);
        }
        const total = base + extra;
        for (const id of ['top-total', 'hero-total', 'ticket-total']) setText(id, eur(total));
        const note =
          missing.length === 0
            ? 'con todo elegido'
            : `sin ${missing.length === 1 ? missing[0] : `${missing.slice(0, -1).join(', ')} ni ${missing[missing.length - 1]}`}`;
        setText('hero-note', note);
        setText('paid', eur(paid));
        setText('left', eur(total - paid));
        (document.getElementById('bar-fill') as HTMLElement).style.width = `${total ? (paid / total) * 100 : 0}%`;
      };
      document.addEventListener('click', (e) => {
        const setBtn = (e.target as Element).closest<HTMLButtonElement>('.js-pick-set');
        if (setBtn) {
          for (const p of JSON.parse(setBtn.dataset.set ?? '[]') as { g: string; id: string; name: string; price: number }[]) {
            picks[p.g] = { id: p.id, name: p.name, price: p.price };
          }
          savePicks();
          paint();
          document.getElementById('total')?.scrollIntoView({ behavior: 'smooth' });
          return;
        }
        const b = (e.target as Element).closest<HTMLButtonElement>('.js-pick');
        if (!b) return;
        const g = b.dataset.grupo!;
        if (picks[g]?.id === b.dataset.id) delete picks[g];
        else picks[g] = { id: b.dataset.id!, name: b.dataset.name!, price: Number(b.dataset.price) };
        savePicks();
        paint();
      });
      document.addEventListener('change', (e) => {
        const t = e.target as HTMLInputElement;
        if (t.matches('.js-bought')) {
          t.checked ? bought.add(t.value) : bought.delete(t.value);
          write(KB, [...bought]);
          paint();
        }
        if (t.matches('.js-todo')) {
          const done = [...document.querySelectorAll<HTMLInputElement>('.js-todo:checked')].map((x) => x.value);
          write(KT, done);
        }
      });
      paint();

      // Pendientes
      const todo = new Set(read(KT));
      document.querySelectorAll<HTMLInputElement>('.js-todo').forEach((i) => (i.checked = todo.has(i.value)));

      // Galería ampliada
      const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
      const big = dlg.querySelector('img')!;
      document.querySelectorAll<HTMLButtonElement>('.gallery__open').forEach((b) =>
        b.addEventListener('click', () => {
          big.src = b.dataset.full ?? '';
          big.alt = b.dataset.alt ?? '';
          dlg.showModal();
        }),
      );
      dlg.addEventListener('click', (e) => {
        if (e.target === dlg) dlg.close();
      });
    </script>

