      }
      .ticket__row--pick.is-picked .ticket__name a {
        color: var(--ink);
        text-decoration: none;
      }
      /* El Mac */
      .mac {
        max-width: 980px;
        margin: 0 auto clamp(40px, 6vw, 64px);
      }
      .mac h3 {
        margin: 0 0 20px;
        text-align: center;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 14px;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--gold);
      }
      .mac__steps {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: m;
      }
      .mac__steps li {
        position: relative;
        padding: 22px 20px 20px;
        background: var(--coal);
        border: 1px solid var(--line-dark);
        border-top: 2px solid var(--gold);
        counter-increment: m;
      }
      .mac__steps h4 {
        margin: 0 0 8px;
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 14px;
        line-height: 1.4;
        color: var(--gold-light);
      }
      .mac__steps p {
        margin: 0;
        font-size: 15px;
        color: var(--muted);
      }

      /* Los 3 sets */
      .sets {
        display: grid;
        gap: clamp(28px, 5vw, 48px);
      }
      .set {
        display: grid;
        border: 1px solid var(--line-dark);
        background: var(--coal);
      }
      @media (min-width: 1000px) {
        .set {
          grid-template-columns: 2.2fr 1fr;
        }
      }
      .set__img :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .set__info {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: clamp(20px, 3vw, 30px);
      }
      .set__n {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 300;
        font-size: 28px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--gold);
      }
      .set__parts {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .set__parts li {
        display: grid;
        grid-template-columns: 70px 1fr auto;
        gap: 10px;
        align-items: baseline;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--line-dark);
        font-size: 15px;
      }
      .set__parts span {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .set__parts a {
        color: var(--cream);
        text-decoration: underline;
        text-decoration-color: var(--line-dark);
        text-underline-offset: 4px;
      }
      .set__parts b {
        font-family: var(--font-display);
        font-weight: 400;
        color: var(--gold-light);
        white-space: nowrap;
      }
      .set__sum {
        margin: 0;
        color: var(--muted);
      }
      .set__sum b {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 22px;
        color: var(--gold-light);
      }
      .set .btn {
        align-self: flex-start;
        margin-top: auto;
      }

      /* Cuarto */
      .room {
        display: grid;
        gap: clamp(28px, 5vw, 56px);
        align-items: center;
      }
      @media (min-width: 900px) {
        .room {
          grid-template-columns: 1.1fr 1fr;
        }
      }
      .room__plan {
        margin: 0;
      }
      .room__plan svg {
        width: 100%;
        height: auto;
        font-family: var(--font-body);
      }
      .room__plan figcaption {
        margin-top: 8px;
        font-size: 13px;
        color: var(--muted);
        text-align: center;
      }
      .pl-floor {
        fill: #18181b;
      }
      .pl-wall {
        fill: none;
        stroke: var(--cream);
        stroke-width: 4;
      }
      .pl-box {
        fill: #26262a;
        stroke: #4a4a50;
        stroke-width: 1;
      }
      .pl-glass {
        fill: #6f8fb3;
      }
      .pl-swing {
        fill: none;
        stroke: var(--muted);
        stroke-width: 1;
        stroke-dasharray: 4 3;
      }
      .pl-desk {
        fill: var(--gold);
      }
      .pl-screens {
        fill: var(--black);
      }
      .pl-desk-t {
        font-size: 12px;
        font-weight: 700;
        fill: var(--black);
        letter-spacing: 0.04em;
      }
      .pl-chair {
        fill: none;
        stroke: var(--gold-light);
        stroke-width: 2;
      }
      .pl-plug {
        fill: var(--gold-light);
      }
      .pl-rad {
        fill: #c8734f;
      }
      .pl-cam {
        fill: none;
        stroke: var(--gold);
        stroke-width: 1;
        stroke-dasharray: 6 4;
        opacity: 0.7;
      }
      .pl-t {
        font-size: 11px;
        fill: var(--cream-2);
      }
      .pl-gold {
        font-size: 11px;
        font-weight: 700;
        fill: var(--gold-light);
      }
      .pl-cap {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        fill: var(--muted);
        text-transform: uppercase;
      }
      .pl-cam-t {
        font-size: 11px;
        fill: var(--gold);
        font-style: italic;
      }
      .reasons {
        display: grid;
        gap: 22px;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .reasons li {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 18px;
        align-items: start;
        padding-bottom: 22px;
        border-bottom: 1px solid var(--line-dark);
      }
      .reasons__n {
        font-family: var(--font-display);
        font-weight: 300;
        font-size: 30px;
        line-height: 1;
        color: var(--gold);
      }
      .reasons h3 {
        margin: 0 0 6px;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 14px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }
      .reasons p {
        margin: 0;
        color: var(--muted);
      }

      /* Conexiones */
      .cols {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
        gap: clamp(28px, 4vw, 44px);
      }
      .col h3 {
        margin: 0 0 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--ink);
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 14px;
        letter-spacing: 0.26em;
        text-transform: uppercase;
      }
      .steps {
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: s;
      }
      .steps li {
        position: relative;
        padding: 0 0 14px 40px;
        counter-increment: s;
        color: var(--ink-soft);
      }
      .steps li::before {
        content: counter(s);
        position: absolute;
        left: 0;
        top: -1px;
        display: grid;
        place-items: center;
        width: 26px;
        height: 26px;
        border: 1px solid var(--gold-deep);
        border-radius: 50%;
        font-family: var(--font-display);
        font-size: 12px;
        color: var(--gold-deep);
      }
      .ports {
        margin: 0;
      }
      .ports div {
        display: grid;
        grid-template-columns: 96px 1fr;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid var(--line-light);
      }
      .ports dt {
        font-weight: 700;
        color: var(--gold-deep);
      }
      .ports dd {
        margin: 0;
        color: var(--ink-soft);
      }
      .col__note {
        margin: 12px 0 0;
        font-size: 14px;
        color: var(--ink-soft);
      }
      .ticks {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .ticks li {
        position: relative;
        padding: 0 0 14px 28px;
        color: var(--ink-soft);
      }
      .ticks li::before {
        content: '✦';
        position: absolute;
        left: 0;
        top: 0;
        color: var(--gold-deep);
      }
      .ticks--dark li {
        color: var(--cream-2);
      }
      .ticks--dark li::before {
        color: var(--gold);
      }
      .ticks :global(code) {
        padding: 1px 6px;
        background: var(--coal-2);
        border: 1px solid var(--line-dark);
        font-size: 13px;
        color: var(--gold-light);
      }

      /* Hermes */
      .flow {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
        gap: 10px;
        margin: 0 0 clamp(36px, 6vw, 56px);
        padding: 0;
        list-style: none;
      }
      .flow li {
        padding: 26px 22px;
        background: var(--coal);
        border: 1px solid var(--line-dark);
      }
      .flow__n {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        margin-bottom: 14px;
        border-radius: 50%;
        background: var(--gold);
        color: var(--black);
        font-family: var(--font-display);
        font-weight: 500;
      }
      .flow h3 {
        margin: 0 0 6px;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 14px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--gold-light);
      }
      .flow p {
        margin: 0;
        color: var(--muted);
      }
      .server {
        max-width: 780px;
        margin: 0 auto;
      }
      .server h3 {
        margin: 0 0 18px;
        text-align: center;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 14px;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--gold);
      }

      /* Pendientes */
      .todo {
        max-width: 760px;
        margin: 0 auto;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--line-light);
      }
      .todo li {
        border-bottom: 1px solid var(--line-light);
      }
      .todo label {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 14px 4px;
        cursor: pointer;
      }
      .todo input {
        flex-shrink: 0;
        width: 20px;
        height: 20px;
        margin-top: 2px;
        accent-color: var(--gold-deep);
      }
      .todo input:checked + span {
        color: #9a917e;
        text-decoration: line-through;
      }

      /* Pie */
      .foot {
        padding: clamp(48px, 7vw, 72px) var(--gutter);
        text-align: center;
        border-top: 1px solid var(--line-dark);
      }
      :global(.foot__logo) {
        width: 64px;
        height: 64px;
        margin: 0 auto 14px;
        border-radius: 50%;
        border: 1px solid var(--gold);
      }
      .foot__name {
        margin: 0 0 10px;
        font-family: var(--font-display);
        font-size: 13px;
        letter-spacing: 0.34em;
        padding-left: 0.34em;
        text-transform: uppercase;
        color: var(--gold);
      }
      .foot__small {
        max-width: 620px;
        margin: 0 auto;
        font-size: 13px;
        color: var(--muted);
      }
      .foot__small a {
        color: var(--gold-light);
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      /* Ampliar imagen */
      .lightbox {
        width: min(96vw, 1600px);
        max-height: 92vh;
        padding: 0;
        border: 1px solid var(--gold);
        background: var(--black);
      }
      .lightbox::backdrop {
        background: rgba(0, 0, 0, 0.85);
      }
      .lightbox img {
        width: 100%;
        height: auto;
        max-height: 90vh;
        object-fit: contain;
      }
      .lightbox__close {
        position: absolute;
        right: 8px;
        top: 6px;
        width: 40px;
        height: 40px;
        border: 0;
        border-radius: 50%;
        background: rgba(10, 10, 11, 0.8);
        color: var(--gold-light);
        font-size: 26px;
        line-height: 1;
        cursor: pointer;
      }
    </style>
  </body>
</html>
